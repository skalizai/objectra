# Supabase — from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — from resend.com; EMAIL_FROM must use a verified sending domain
RESEND_API_KEY=
EMAIL_FROM="Objectra Labs <notifications@objectralabs.org>"

# App URL used in email links (invite, deadline alerts, weekly digest)
APP_URL=http://localhost:3000

# Random secret shared with the Vercel Cron jobs hitting /api/jobs/*
CRON_SECRET=
